NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_KEEP_ALIVE_TABLE=profiles

# Backend migration switch.
# Keep "supabase" until the Tencent CloudBase/PostgreSQL implementation is ready.
CODL_BACKEND_PROVIDER=supabase

# Future Tencent CloudBase production backend values.
# These are intentionally unused while CODL_BACKEND_PROVIDER=supabase.
CLOUDBASE_ENV_ID=
CLOUDBASE_SERVICE_NAME=codl
TENCENT_POSTGRES_URL=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=
